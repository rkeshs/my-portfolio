---
import { skills } from "@/lib/data";
import SectionHeading from "./SectionHeading.astro";
---

<section id="skills" class="scroll-mt-16 bg-coral py-20 text-ink md:py-28">
  <div class="mx-auto max-w-6xl px-6 md:px-8">
    <div data-reveal>
      <SectionHeading>Skills</SectionHeading>
    </div>

    <div class="divide-y divide-ink border-b-2 border-ink">
      {
        skills.map(({ label, items }, index) => (
          <div
            data-reveal
            style={`--reveal-delay: ${index * 50}ms`}
            class="grid gap-2 py-5 md:grid-cols-[180px_1fr] md:gap-8 md:py-6"
          >
            <h3 class="text-sm font-black">{label}</h3>
            <ul class="flex flex-wrap gap-x-3 gap-y-2 font-display text-xl leading-tight md:text-2xl">
              {items.map((skill) => (
                <li class="whitespace-nowrap after:ml-3 after:text-sun after:content-['/'] last:after:hidden">
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
