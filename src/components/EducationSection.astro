---
import { education } from "@/lib/data";
import SectionHeading from "./SectionHeading.astro";
---

<section id="education" class="scroll-mt-16 bg-background py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6 md:px-8">
    <div data-reveal>
      <SectionHeading>Education & Leadership</SectionHeading>
    </div>

    <div>
      {
        education.map((edu) => (
          <div
            data-reveal
            class="grid gap-8 border-b-2 border-foreground py-8 md:grid-cols-[1.15fr_0.85fr] md:py-12"
          >
            <div>
              <p class="font-display text-xl text-ember">{edu.period}</p>
              <h3 class="mt-3 max-w-xl text-3xl font-black tracking-tight md:text-5xl">
                {edu.degree}
              </h3>
              <p class="mt-4 max-w-xl font-semibold text-muted-foreground">
                {edu.institution} · {edu.location}
              </p>
            </div>

            {edu.achievements && edu.achievements.length > 0 && (
              <ul class="space-y-4 md:pt-2">
                {edu.achievements.map((achievement) => (
                  <li class="flex gap-3 leading-relaxed text-muted-foreground">
                    <span class="mt-2 h-2 w-2 shrink-0 bg-ember" aria-hidden="true" />
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
