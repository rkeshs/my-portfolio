---
import type { ProjectArtwork } from "@/lib/data";

interface Props {
  artwork: ProjectArtwork;
}

const { artwork } = Astro.props;
---

{
  artwork === "insurance" && (
    <div class="relative aspect-4/3 overflow-hidden bg-acid text-ink" aria-hidden="true">
      <div class="absolute left-[9%] top-[11%] h-[72%] w-[53%] bg-coral" />
      <div class="absolute left-[6%] top-[8%] h-[72%] w-[53%] border-2 border-ink bg-[#fffdf5] p-[7%]">
        <div class="font-display text-[clamp(1.05rem,4vw,2rem)] leading-none">EMPLOYEE</div>
        <div class="mt-[10%] h-[3%] w-[72%] bg-ink/25" />
        <div class="mt-[6%] flex items-center gap-[5%]">
          <span class="h-[clamp(0.55rem,2vw,0.9rem)] w-[clamp(0.55rem,2vw,0.9rem)] border-2 border-ink bg-coral" />
          <span class="h-1 w-[62%] bg-ink/65" />
        </div>
        <div class="mt-[6%] flex items-center gap-[5%]">
          <span class="h-[clamp(0.55rem,2vw,0.9rem)] w-[clamp(0.55rem,2vw,0.9rem)] border-2 border-ink bg-acid" />
          <span class="h-1 w-[76%] bg-ink/65" />
        </div>
        <div class="mt-[6%] flex items-center gap-[5%]">
          <span class="h-[clamp(0.55rem,2vw,0.9rem)] w-[clamp(0.55rem,2vw,0.9rem)] border-2 border-ink bg-coral" />
          <span class="h-1 w-[52%] bg-ink/65" />
        </div>
        <div class="absolute bottom-[8%] left-[13%] bg-ink px-[6%] py-[3%] font-display text-[clamp(0.65rem,2.4vw,0.95rem)] text-white">
          VALIDATED
        </div>
      </div>
      <div class="absolute left-[61%] top-1/2 h-1 w-[10%] -translate-y-1/2 bg-ink" />
      <div class="absolute left-[69%] top-1/2 h-0 w-0 -translate-y-1/2 border-y-[8px] border-l-[12px] border-y-transparent border-l-ink" />
      <div class="absolute right-[6%] top-[17%] grid w-[21%] gap-[10%]">
        {["API", "PDF", "CSV"].map((format, formatIndex) => (
          <div
            class={`border-2 border-ink px-[8%] py-[16%] text-center font-display text-[clamp(0.7rem,2.7vw,1.15rem)] ${
              formatIndex === 0 ? "bg-ink text-white" : "bg-coral"
            }`}
          >
            {format}
          </div>
        ))}
      </div>
      <div class="absolute bottom-[6%] right-[6%] font-display text-[clamp(0.7rem,2.5vw,1rem)]">
        FORM → INSURER
      </div>
    </div>
  )
}

{
  artwork === "store" && (
    <div class="relative aspect-4/3 overflow-hidden bg-coral text-ink" aria-hidden="true">
      <div class="absolute left-[7%] top-[9%] h-[68%] w-[76%] border-2 border-ink bg-[#fffdf5]">
        <div class="flex h-[14%] items-center gap-[2%] border-b-2 border-ink px-[4%]">
          <span class="h-[clamp(0.35rem,1.4vw,0.6rem)] w-[clamp(0.35rem,1.4vw,0.6rem)] rounded-full bg-coral" />
          <span class="h-[clamp(0.35rem,1.4vw,0.6rem)] w-[clamp(0.35rem,1.4vw,0.6rem)] rounded-full bg-acid" />
          <span class="h-[clamp(0.35rem,1.4vw,0.6rem)] w-[clamp(0.35rem,1.4vw,0.6rem)] rounded-full bg-ink" />
          <span class="ml-auto font-display text-[clamp(0.6rem,2.2vw,0.9rem)]">MY STORE</span>
        </div>
        <div class="grid h-[86%] grid-cols-2 gap-[6%] p-[7%]">
          <div class="border-2 border-ink bg-acid p-[8%]">
            <div class="aspect-square bg-ink/15" />
            <div class="mt-[12%] h-1 w-[72%] bg-ink" />
            <div class="mt-[8%] h-1 w-[45%] bg-ink/40" />
          </div>
          <div class="border-2 border-ink bg-coral/60 p-[8%]">
            <div class="aspect-square bg-ink/15" />
            <div class="mt-[12%] h-1 w-[68%] bg-ink" />
            <div class="mt-[8%] h-1 w-[52%] bg-ink/40" />
          </div>
        </div>
      </div>
      <div class="absolute bottom-[7%] right-[5%] w-[43%] border-2 border-ink bg-ink p-[4%] text-white shadow-[-8px_8px_0_0_#b4f000]">
        <div class="flex items-center justify-between">
          <span class="font-display text-[clamp(0.7rem,2.5vw,1rem)]">PAYMENT</span>
          <span class="flex h-[clamp(1.1rem,4vw,1.7rem)] w-[clamp(1.1rem,4vw,1.7rem)] items-center justify-center rounded-full bg-coral font-bold text-ink">
            ✓
          </span>
        </div>
        <div class="mt-[8%] h-1 w-full bg-white/30" />
        <div class="mt-[6%] h-1 w-[62%] bg-white/30" />
      </div>
    </div>
  )
}

{
  artwork === "media" && (
    <div
      class="relative aspect-4/3 overflow-hidden bg-hero-background text-hero-foreground"
      aria-hidden="true"
    >
      <div class="absolute left-[7%] top-[12%] h-[62%] w-[58%] border-2 border-acid bg-coral" />
      <div class="absolute left-[11%] top-[8%] h-[62%] w-[58%] border-2 border-hero-foreground bg-ink">
        <div class="absolute left-1/2 top-[44%] flex h-[clamp(3rem,12vw,5.4rem)] w-[clamp(3rem,12vw,5.4rem)] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-acid">
          <span class="ml-[8%] h-0 w-0 border-y-[12px] border-l-[20px] border-y-transparent border-l-acid" />
        </div>
        <div class="absolute bottom-[10%] left-[8%] right-[8%] flex h-[18%] items-end gap-[3%]">
          {[35, 70, 48, 88, 58, 76, 42, 65].map((height, barIndex) => (
            <span
              class="flex-1 bg-coral"
              style={`height: ${height}%`}
              data-bar={barIndex}
            />
          ))}
        </div>
      </div>
      <div class="absolute right-[5%] top-[9%] grid w-[23%] gap-2 font-display text-[clamp(0.58rem,2.1vw,0.85rem)] text-ink">
        <div class="bg-acid px-[8%] py-[12%] text-center">INPUT</div>
        <div class="text-center text-acid">↓</div>
        <div class="bg-coral px-[8%] py-[12%] text-center">RENDER</div>
        <div class="text-center text-acid">↓</div>
        <div class="bg-[#fffdf5] px-[8%] py-[12%] text-center">PUBLISH</div>
      </div>
      <div class="absolute bottom-[7%] right-[5%] font-display text-[clamp(0.7rem,2.5vw,1rem)] text-acid">
        VIDEO WORKFLOW
      </div>
    </div>
  )
}
