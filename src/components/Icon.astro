---
/** Matches the (unexported) `IconSvgObject` shape from `@hugeicons/core-free-icons`. */
type IconSvgObject = readonly (readonly [
  tag: string,
  attributes: { readonly [key: string]: string | number },
])[];

interface Props {
  icon: IconSvgObject;
  class?: string;
  size?: number;
  strokeWidth?: number;
}

const { icon, class: className, size = 24, strokeWidth } = Astro.props;

const kebab = (key: string) => key.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);
const inner = icon
  .map(([tag, attrs]) => {
    const attr = Object.entries(attrs)
      .filter(([key]) => key !== "key" && (strokeWidth === undefined || key !== "strokeWidth"))
      .map(([key, value]) => `${kebab(key)}="${String(value)}"`)
      .join(" ");
    return `<${tag} ${attr}></${tag}>`;
  })
  .join("");
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  color="currentColor"
  stroke="currentColor"
  stroke-width={strokeWidth}
  class={className}
  aria-hidden="true"
  set:html={inner}
/>
